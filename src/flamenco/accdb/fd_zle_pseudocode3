zle_put_vint(out, n):
    if likely(n < 0xff):
        out[0] = u8(n)
        return out + 1
    n -= 0xff
    v = 0xff 
loop:
    out[0] = v
    out += 1
    v = (n & 0x7f) | 0x80
    n >>= 7
    if n > 0: goto loop
    out[0] = v & 0x7f
    return out

